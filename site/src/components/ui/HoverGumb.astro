---
// 21st.dev „Interactive Hover Button” (@dillionverma, Magic UI) — izvornik u podovi-gjp/komponente-21st/.
// Prenesen doslovno: iste Tailwind klase, oblik, točka koja se širi u ispunu i strelica (lucide ArrowRight).
// Jedine razlike: <a> umjesto <button> (CTA vodi na stranicu), širina prema tekstu umjesto fiksnih w-32,
// najmanja visina 44 px (dodir), točka na fiksnih 1.75rem umjesto 20 % (duži tekst bi je prekrio),
// sadržaj na hoveru vizualno centriran (+2.5px umjesto -translate-x-1, jer strelica u ikoni ima 5px praznine desno),
// i iste promjene na :focus-visible kao na hoveru (tipkovnica).
// Boje: točka/ispuna crna i bijeli tekst kao u originalu; u tamnoj sekciji se obrću (--hg-*).
interface Props {
  href: string;
  tekst: string;
  mali?: boolean;
  class?: string;
}

const { href, tekst, mali = false, class: klasa = '' } = Astro.props;
---

<a
  href={href}
  class:list={[
    'hover-gumb group relative inline-flex min-h-11 cursor-pointer items-center justify-center overflow-hidden rounded-full border border-border bg-background p-2 pl-10 pr-7 text-center font-semibold text-foreground no-underline',
    mali ? 'text-[0.95rem]' : 'text-base',
    klasa,
  ]}
>
  <span
    class="tekst inline-block translate-x-1 transition-all duration-300 group-hover:translate-x-12 group-hover:opacity-0 group-focus-visible:translate-x-12 group-focus-visible:opacity-0"
    >{tekst}</span
  >
  <span
    aria-hidden="true"
    class="absolute top-0 left-0 z-10 flex h-full w-full translate-x-12 items-center justify-center gap-2 text-[var(--hg-tekst)] opacity-0 transition-all duration-300 group-hover:translate-x-[2.5px] group-hover:opacity-100 group-focus-visible:translate-x-[2.5px] group-focus-visible:opacity-100"
  >
    <span>{tekst}</span>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
  </span>
  <span
    data-tocka
    aria-hidden="true"
    class="absolute top-[40%] left-[1.75rem] h-2 w-2 scale-[1] rounded-lg bg-[var(--hg-tocka)] transition-all duration-300 group-hover:top-[0%] group-hover:left-[0%] group-hover:h-full group-hover:w-full group-hover:scale-[1.8] group-focus-visible:top-[0%] group-focus-visible:left-[0%] group-focus-visible:h-full group-focus-visible:w-full group-focus-visible:scale-[1.8]"
  ></span>
</a>

<style>
  .hover-gumb {
    --hg-tocka: var(--crna);
    --hg-tekst: var(--gips);
  }
  :global(.dark-section) .hover-gumb {
    --hg-tocka: var(--gips);
    --hg-tekst: var(--crna);
  }
</style>
