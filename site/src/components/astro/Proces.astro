---
const koraci = [
  { naslov: 'Izlazak na teren', tekst: 'Pregledamo prostor, izmjerimo površinu i provjerimo pristup, kat i dizalo za unos materijala.' },
  { naslov: 'Mjerenje vlage CM metodom', tekst: 'Izmjerimo preostalu vlagu i ravninu podloge, pa znamo kakva priprema treba prije polaganja.' },
  { naslov: 'Ponuda u roku 48 sati', tekst: 'Jasna ponuda s pripremom podloge, završnim radovima i logistikom navedenima kao zasebne stavke.' },
  { naslov: 'Izvedba', tekst: 'Priprema podloge, polaganje i završni radovi u dogovorenom terminu.' },
  { naslov: 'Primopredaja', tekst: 'Zajednički pregled, upute za održavanje i jamstvo na izvedene radove.' },
];
---

<section class="proces" aria-labelledby="proces-naslov" data-proces>
  <div class="wrap grid">
    <h2 id="proces-naslov">Kako radimo</h2>
    <ol>
      {koraci.map((k) => (
        <li>
          <h3>{k.naslov}</h3>
          <p>{k.tekst}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .proces { background: var(--estrih); }
  .grid {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.5rem;
    padding-block: clamp(4rem, 8vw, 6rem);
  }
  h2 { grid-column: 1 / span 4; margin: 0; font-size: clamp(2.2rem, 4.5vw, 3.6rem); }
  ol { grid-column: 5 / span 8; list-style: none; margin: 0; padding: 0; counter-reset: korak; }
  li {
    counter-increment: korak; display: grid; grid-template-columns: 4rem 1fr; column-gap: 1rem;
    padding-block: 1.25rem; border-top: 1px solid rgb(0 0 0 / 0.15);
  }
  li::before {
    content: counter(korak); grid-row: span 2; font-size: 2.6rem; line-height: 0.9; font-weight: 900;
    font-stretch: 62%; color: transparent; -webkit-text-stroke: 1.2px var(--crna);
  }
  h3 { margin: 0; font-size: 1.4rem; font-stretch: 85%; line-height: 1.2; }
  p { margin: 0.35rem 0 0; max-width: 40em; }
  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
    h2, ol { grid-column: 1; }
  }
</style>
