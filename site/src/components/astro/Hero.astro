---
import HoverGumb from "../ui/HoverGumb.astro";
import { ribljaKostSvg } from '../../lib/presjek';

const pod = ribljaKostSvg({ width: 400, height: 500, w: 22, L: 88 });
---

<section class="hero">
  <div class="wrap grid">
    <div class="text">
      <h1>Stručnjaci za podne obloge</h1>
      <p class="lead">
        Izvodimo kompletan spektar podopolagačkih radova za poslovne, javne i privatne prostore diljem Hrvatske, uz poseban
        fokus na LVT podne obloge, tepihe, PVC podove u roli i epoksidne sustave.
      </p>
      <div class="actions">
        <HoverGumb href="/zatrazi-ponudu/" tekst="Zatraži ponudu" />
        <a class="btn btn-secondary" href="/reference/">Pogledaj reference</a>
      </div>
    </div>
    <div class="floor" set:html={pod} />
  </div>
</section>

<style>
  .grid {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 0 1.5rem;
    padding-block: clamp(2.5rem, 6vw, 5.5rem); align-items: end;
  }
  .text { grid-column: 1 / span 7; }
  h1 {
    margin: 0 0 1.75rem; font-size: clamp(3rem, 9vw, 8.4rem); line-height: 0.88;
    font-weight: 850; font-stretch: 62%; letter-spacing: -0.01em;
  }
  .lead { margin: 0 0 2.25rem; max-width: 34em; font-size: 1.25rem; line-height: 1.55; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .floor { grid-column: 8 / span 5; aspect-ratio: 4 / 5; background: var(--estrih); overflow: hidden; }
  .floor :global(svg) { display: block; width: 100%; height: 100%; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
    .text, .floor { grid-column: 1; }
    .floor { aspect-ratio: 16 / 10; margin-top: 2.5rem; }
  }
</style>
