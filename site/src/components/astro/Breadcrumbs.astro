---
interface Props {
  items: { naziv: string; path: string }[];
}
const { items } = Astro.props;
---

<nav class="wrap breadcrumbs" aria-label="Putanja">
  <ol>
    {items.map((it, i) => (
      <li>
        {i < items.length - 1 ? <a href={it.path}>{it.naziv}</a> : <span aria-current="page">{it.naziv}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs { padding-top: 1.5rem; }
  ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 0.5rem; font-size: 0.95rem; }
  li:not(:last-child)::after { content: '/'; margin-left: 0.5rem; color: var(--nivelir); }
  a { color: inherit; text-decoration-line: underline; text-underline-offset: 4px; text-decoration-color: var(--primary); }
  span { color: var(--nivelir); }
</style>
