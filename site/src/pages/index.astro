---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/astro/Hero.astro';
import ObjektiStrip from '../components/astro/ObjektiStrip.astro';
import Presjek from '../components/astro/Presjek.astro';
import { getCollection } from 'astro:content';
import { businessSchema, websiteSchema } from '../lib/schema';

const usluge = await getCollection('usluge');
const jsonLd = [businessSchema(usluge.map((u) => u.data.naslov)), websiteSchema()];
---

<BaseLayout
  title="Stručnjaci za podne obloge"
  description="Podopolagački radovi za poslovne, javne i privatne prostore diljem Hrvatske: LVT podne obloge, tepisi, PVC podovi u roli i epoksidni sustavi."
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <Hero />
  <ObjektiStrip />
  <Presjek />
</BaseLayout>
